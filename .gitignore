# Python / Entornos Virtuales
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.env
.venv
env/
*.egg-info/

# Jupyter Notebooks
.ipynb_checkpoints

# Ignorar el contenido de datos pero mantener las carpetas y los punteros
# de DVC (*.dvc) — ver docs/decisions/0007_dvc_data_versioning.md.
data/raw/*
data/processed/*
!data/**/.gitkeep
!data/**/*.dvc

# Ignorar modelos pesados y resultados locales, mantener carpetas
models/candidates/*
!models/candidates/.gitkeep
models/*.pkl
experiments/**/results/*
!experiments/**/results/.gitkeep
experiments/**/reports/*
!experiments/**/reports/.gitkeep

# Caches de herramientas
.ruff_cache/
.pytest_cache/
pipelines/data/build/.signal_features_cache/
**/notebooks/nbrun*.log
pipelines/data/build/build_run.log
pipelines/data/build_*_run.log

# Artefactos generados
experiments_summary.csv
test-results.xml

# MLflow local (backend sqlite/artifacts por defecto cuando se prueba sin
# Azure ML — ver docs/decisions/0009_mlflow_logging_convention.md)
mlruns/
mlflow.db
*.db-journal

# IDEs y OS
.vscode/
.idea/
.DS_Store
Thumbs.db
