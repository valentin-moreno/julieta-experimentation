# Copia este archivo a .env (ya ignorado por git, nunca se comitea) y completa
# el valor real. Ver docs/decisions/0005-mlflow-tracking.md para el detalle.
#
# Cómo obtener la URL, una vez tengas el rol "AzureML Data Scientist" sobre el
# workspace y hayas corrido `az login` con tu cuenta de Salva Health:
#   az ml workspace show --name ml-salva-dev --resource-group ml-ops \
#     --query mlflow_tracking_uri -o tsv
MLFLOW_TRACKING_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_API_KEY=
AZURE_STORAGE_CONNECTION_STRING=